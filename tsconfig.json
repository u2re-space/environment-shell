{
    "include": [
        "./src/**/*.ts",
        "./demo/**/*.ts",
        "./test/**/*.ts",
        "./*.js",
        "../../views/view-resolve-aliases.js",
        "../../views/shared/vite.view.config.js",
        "../../views/shared/vite-ssre.mjs",
        "../../projects/fl.ui/src/ui/speed-dial/needs-to-API.ts"
    ],
    "exclude": ["./dist/**/*"],
    "compilerOptions": {
        "rootDir": "../..",
        "outDir": "./dist/",
        "paths": {
            "views/types": ["../../views/shared/types.ts"],
            "views/home-view": ["../../views/home-view/src/index.ts"],
            "@fest-lib/dom": ["../../projects/dom.ts/src/index.ts"],
            "@fest-lib/style-lib": ["../../projects/style.ts/src/index.ts"],
            "@fest-lib/lure": ["../../projects/lur.e/src/index.ts"],
            "@fest-lib/object": ["../../projects/object.ts/src/index.ts"],
            "@fest-lib/core": ["../../projects/core.ts/src/index.ts"],
            "@fest-lib/icon": ["../../projects/icon.ts/src/index.ts"],
            "@fest-lib/fl-ui": ["../../projects/fl.ui/src/index.ts"],
            "@fest-lib/image": ["../../projects/image.ts/src/index.ts"],
            "@fest-lib/ui": ["../../projects/fl.ui/src/index.ts"],
            "@fest-lib/uniform": ["../../projects/uniform.ts/src/index.ts"],
            "@fest-lib/subsystem": ["../../projects/subsystem/src/index.ts"],
            "veela-lib": ["../../projects/veela.css/src/scss/index.scss"],
            "veela-lib/*": ["../../projects/veela.css/src/scss/*"],
            
            "boot/*": ["../shared/src/boot/*"],
            "views/*": ["../shared/views/*"],
            "shells/*": ["../shared/shells/*"],
            "core/*": ["../shared/src/*"],
            "com/*": ["../shared/src/*"],
            "shared/*": ["../shared/src/*"],
            "@shared/*": ["../shared/*"],
            "fonts/*": ["../shared/assets/fonts/*"]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "WebWorker"],
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "declaration": false,
        "noEmit": true,
        "experimentalDecorators": true
    }
}
